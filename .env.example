# ─────────────────────────────────────────────────────────────────
#  雪球监控配置模板  （复制为 .env 后填写真实值）
# ─────────────────────────────────────────────────────────────────

# 雪球 Cookie（必填）
# 获取方式：登录 https://xueqiu.com → F12 → Network → 任意请求
#           → Request Headers → Cookie → 复制完整内容
XUEQIU_COOKIE=xq_a_token=你的token;u=你的uid

# 钉钉机器人 Webhook（必填）
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=你的access_token

# 监控的雪球组合代码，多个用英文逗号分隔（必填）
MONITORED_CUBES=ZH123456

# ─────────────────────────────────────────────────────────────────
#  以下为可选配置（有默认值，可不填）
# ─────────────────────────────────────────────────────────────────

# 检查间隔（秒），默认 300 秒 = 5 分钟
CHECK_INTERVAL=300

# 仓位权重变动触发通知的阈值（百分点），默认 1.0
WEIGHT_CHANGE_THRESHOLD=1.0

# 是否 @所有人，true / false（默认 false）
AT_ALL=false

# 日志文件路径（默认 xueqiu_monitor.log），留空则只输出到终端
LOG_FILE=xueqiu_monitor.log
